# Local demo only (`npm run dev`). Do not set these on Vercel.
# A hosted build with no VITE_CHAIN_ID uses the Sepolia deployment.
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_CHAIN_ID=31337

# Optional on Vercel (Project → Settings → Environment Variables).
# Both are baked into the static site at build time. Leave them unset to use public Sepolia RPCs.
# VITE_CHAIN_ID=11155111
# VITE_RPC_URL=https://your-sepolia-endpoint

# Contracts (contracts/.env, never commit). Not required to host the website.
# SEPOLIA_RPC_URL=
# SEPOLIA_PRIVATE_KEY=
# ORG_LABEL=onshift
# SALT_TAG=onshift-v1
# LEAD_ADDRESS=
# TREASURY_ADDRESS=
